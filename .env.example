# Copiar a .env.local y rellenar. NUNCA commitear .env.local.

# Base de datos. En local, SQLite es un archivo.
# En producción cambiar a postgresql:// y también el `provider` en prisma/schema.prisma (ARCHITECTURE.md §2).
DATABASE_URL="file:./dev.db"

# Profesor IA. Obtener en https://platform.deepseek.com/
# SOLO se usa desde el servidor (Server Actions / Route Handlers).
# Nunca prefijar con NEXT_PUBLIC_ — eso la expondría al navegador.
DEEPSEEK_API_KEY=""

# Secreto para firmar la cookie de sesión. Generar con: openssl rand -base64 32
SESSION_SECRET=""
